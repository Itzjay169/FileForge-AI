# ============================================================
# FileForge AI - Environment Configuration Example
# ============================================================

# App Configuration
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FileForge AI"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Database (PostgreSQL via Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fileforge_ai?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fileforge_ai?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="fileforge-ultra-secure-development-secret-key-32chars-min"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"
APPLE_ID="your-apple-service-id"
APPLE_SECRET="your-apple-auth-secret-key"

# Storage (Cloudflare R2 / AWS S3 / MinIO)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-r2-or-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-or-s3-secret-access-key"
S3_BUCKET_NAME="fileforge-storage"
S3_REGION="auto"
S3_PUBLIC_DOMAIN="https://cdn.fileforge.ai"

# Redis & Queue (Upstash / Local Redis)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Security & Limits
MAX_UPLOAD_SIZE_FREE_BYTES=2147483648 # 2 GB
MAX_UPLOAD_SIZE_PRO_BYTES=10737418240 # 10 GB
FILE_RETENTION_HOURS_FREE=24
FILE_RETENTION_HOURS_PRO=720 # 30 days
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Virus Scanning (ClamAV or VirusTotal API)
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
VIRUSTOTAL_API_KEY=""

# AI Transparency & OCR
OPENAI_API_KEY=""
TESSERACT_LANG_DIR="/usr/share/tesseract-ocr/4.00/tessdata"

# Contact & Bug Reports Email Delivery (Web3Forms API primary, SMTP fallback)
# Get a free key at https://web3forms.com
WEB3FORMS_ACCESS_KEY="your-web3forms-access-key-here"
# WEBFORM_API_KEY="your-webform-key-alias"

